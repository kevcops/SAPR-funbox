[Unit]
Description=PiKaraoke server for SAPR Funbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=funbox
Group=funbox
Environment=HOME=/home/funbox
Environment=PATH=/home/funbox/.local/bin:/home/funbox/.cargo/bin:/home/funbox/.deno/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/srv/funbox/karaoke
ExecStart=/home/funbox/.local/bin/pikaraoke --headless -d /srv/funbox/karaoke --url http://karaoke.local:5555 --logo-path /opt/funbox/branding/sa-party-logo.png --disable-bg-music
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
