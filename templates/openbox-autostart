#!/bin/sh

# Lightweight desktop services needed for renter-facing Wi-Fi setup.
lxpolkit &
tint2 &
nm-applet &

# Give the desktop services a moment to become ready, then automatically open
# the renter-facing Wi-Fi chooser when no network connection is active.
sleep 2
/usr/local/bin/funbox-wifi-setup

# Give the PiKaraoke service a moment to become ready.
for _ in $(seq 1 60); do
  if curl -fsS http://127.0.0.1:5555/ >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

# PiKaraoke's /splash endpoint is the actual TV/video player. Use the same
# customer-facing origin that PiKaraoke is configured with via --url so its
# Socket.IO origin check accepts the splash player's connection.
chromium \
  --kiosk \
  --no-first-run \
  --disable-session-crashed-bubble \
  --disable-infobars \
  --autoplay-policy=no-user-gesture-required \
  'http://karaoke.local:5555/splash?confirm=false' &
