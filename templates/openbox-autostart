#!/bin/sh

# Lightweight desktop services needed for renter-facing Wi-Fi setup.
lxpolkit &
tint2 &
nm-applet &

# Give the per-user desktop and PipeWire services a moment to become ready.
sleep 2

# Initialize audio before Chromium starts. Auto prefers HDMI/TV when an HDMI
# sink is available, otherwise it falls back to the analog/headphone output.
# This also clears hardware-level ALSA mute state left behind by a prior boot.
/usr/local/bin/funbox-audio auto >/tmp/funbox-audio-startup.log 2>&1 || true

# Automatically open the renter-facing Wi-Fi chooser when no network
# connection is active.
/usr/local/bin/funbox-wifi-setup

# Give the PiKaraoke service a moment to become ready.
for _ in $(seq 1 60); do
  if curl -fsS http://127.0.0.1:5555/ >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

# PiKaraoke's /splash endpoint is the actual TV/video player. Use the same
# customer-facing origin that PiKaraoke is configured with via --url so its
# Socket.IO origin check accepts the splash player's connection.
chromium \
  --kiosk \
  --no-first-run \
  --disable-session-crashed-bubble \
  --disable-infobars \
  --autoplay-policy=no-user-gesture-required \
  'http://karaoke.local:5555/splash?confirm=false' &
