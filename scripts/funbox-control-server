#!/usr/bin/env python3
import json
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOST = "0.0.0.0"
PORT = 5556
AUDIO_HELPER = "/usr/local/bin/funbox-audio"
STATE_FILE = Path("/run/funbox-audio-mode")
ALLOWED = {"auto", "hdmi", "analog", "bluetooth"}


def current_mode():
    try:
        mode = STATE_FILE.read_text().strip()
        if mode in ALLOWED:
            return mode
    except OSError:
        pass
    return "auto"


def set_mode(mode):
    if mode not in ALLOWED:
        raise ValueError("Unsupported audio mode")
    proc = subprocess.run(
        [AUDIO_HELPER, mode],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=40,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stdout.strip() or f"Audio switch failed ({proc.returncode})")
    STATE_FILE.write_text(mode + "\n")
    return proc.stdout.strip()


class Handler(BaseHTTPRequestHandler):
    server_version = "SAPRFunboxAudio/1.0"

    def _headers(self, code=200):
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def _json(self, payload, code=200):
        self._headers(code)
        self.wfile.write(json.dumps(payload).encode("utf-8"))

    def do_OPTIONS(self):
        self._headers(204)

    def do_GET(self):
        if self.path == "/audio":
            self._json({"mode": current_mode()})
        elif self.path == "/health":
            self._json({"ok": True})
        else:
            self._json({"error": "Not found"}, 404)

    def do_POST(self):
        if not self.path.startswith("/audio/"):
            self._json({"error": "Not found"}, 404)
            return
        mode = self.path.rsplit("/", 1)[-1]
        if mode not in ALLOWED:
            self._json({"error": "Unsupported audio mode"}, 400)
            return
        try:
            message = set_mode(mode)
        except (RuntimeError, subprocess.TimeoutExpired) as exc:
            self._json({"error": str(exc)}, 409)
            return
        self._json({"ok": True, "mode": mode, "message": message})

    def log_message(self, fmt, *args):
        print("funbox-control:", fmt % args)


if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
